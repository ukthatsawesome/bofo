{
  "name": "bofo",
  "version": "1.1.0",
  "description": "Bofo - Personal AI-Powered Finance Manager",
  "main": "src/main/main.js",
  "author": {
    "name": "Bofo Team"
  },
  "scripts": {
    "start": "npm run build:css && electron .",
    "dev": "concurrently \"npm run watch:css\" \"electron .\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i ./src/renderer/tailwind-input.css -o ./src/renderer/tailwind.css",
    "watch:css": "tailwindcss -i ./src/renderer/tailwind-input.css -o ./src/renderer/tailwind.css --watch",
    "pack": "npm run build:css && electron-builder --dir",
    "dist": "npm run build:css && electron-builder",
    "dist:win": "npm run build:css && electron-builder --win",
    "dist:mac": "npm run build:css && electron-builder --mac",
    "dist:linux": "npm run build:css && electron-builder --linux"
  },
  "keywords": [
    "finance",
    "personal-finance",
    "electron",
    "ai",
    "budgeting"
  ],
  "license": "ISC",
  "dependencies": {
    "@journeyapps/sqlcipher": "^5.3.1",
    "chart.js": "^4.5.1",
    "lucide": "^0.562.0",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "com.bofo.finance",
    "productName": "Bofo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Finance"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}