# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for shell and config files
*.sh text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.db binary
*.db-shm binary
*.db-wal binary
*.sqlite binary
*.xlsx binary
*.pdf binary
*.exe binary
*.dmg binary
*.pak binary
*.dat binary
*.bin binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
