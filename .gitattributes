# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for shell and config files
*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.db binary
*.sqlite binary
*.xlsx binary
*.pdf binary
*.exe binary
*.dmg binary
*.pak binary
*.dat binary
*.bin binary
