{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        /* ==================== Modules & Resolution ==================== */
        // Override: Node.js requires CommonJS (require) instead of ES Modules (import)
        "module": "CommonJS",
        // Override: Node.js uses Node-specific resolution algorithm
        "moduleResolution": "Node",
        /* ==================== Output Structure ==================== */
        // Output directory for compiled JavaScript
        "outDir": "dist",
        // Root directory of input source files
        "rootDir": "src"
    },
    "include": [
        "src/main/**/*",
        "src/shared/**/*"
    ],
    "exclude": [
        "src/renderer"
    ]
}