{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "target": "ES2022",
        "noEmit": false,
        "noEmitOnError": false
    },
    "include": [
        "src/main/**/*"
    ],
    "exclude": [
        "src/renderer"
    ]
}